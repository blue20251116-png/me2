PORT=3000

# SaaS 회원 시스템 (필수 — 이게 없으면 관리자 계정이 안 만들어져서 아무도 로그인 못 함)
ADMIN_EMAIL=
ADMIN_PASSWORD=
SESSION_SECRET=

# OpenAI 공용 키 (필수 — 회원들이 AI 글쓰기/이미지 생성을 쓸 때 이 키로 과금됨, 운영자만 아는 값)
OPENAI_API_KEY=

# Meta 개발자 앱에서 발급받은 값 (README 참고) — 스레드 계정은 각각 "연결 설정" 탭에서 개별 입력
THREADS_APP_ID=
THREADS_APP_SECRET=
# 배포한 실제 주소 + /auth/callback (예: https://yourapp.up.railway.app/auth/callback)
THREADS_REDIRECT_URI=

# 쿠팡파트너스 개발자센터(partners.coupang.com)에서 발급받은 값
# 여기 안 넣고 배포 후 "연결 설정" 탭에서 직접 입력해도 됨
COUPANG_ACCESS_KEY=
COUPANG_SECRET_KEY=
COUPANG_SUB_ID=
