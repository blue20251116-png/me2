PORT=3000

# SaaS 회원 시스템 (필수 — 이게 없으면 관리자 계정이 안 만들어져서 아무도 로그인 못 함)
ADMIN_EMAIL=
ADMIN_PASSWORD=
SESSION_SECRET=

# OpenAI 공용 키 (필수 — 회원들이 AI 글쓰기/이미지 생성을 쓸 때 이 키로 과금됨, 운영자만 아는 값)
OPENAI_API_KEY=

# Meta 개발자 앱에서 발급받은 값 — 여기 넣어두면 모든 계정이 기본으로 이 값을 씀
# (계정별로 "연결 설정" 탭에서 따로 입력하면 그 계정만 그 값으로 덮어써짐)
THREADS_APP_ID=
THREADS_APP_SECRET=
# 배포한 실제 주소 + /auth/callback (예: https://yourapp.up.railway.app/auth/callback)
THREADS_REDIRECT_URI=

# 쿠팡파트너스 개발자센터(partners.coupang.com)에서 발급받은 값
# 여기 안 넣고 배포 후 "연결 설정" 탭에서 직접 입력해도 됨
COUPANG_ACCESS_KEY=
COUPANG_SECRET_KEY=
COUPANG_SUB_ID=

# 선택: 관리자 화면 대신 환경변수로 공용 네이버 데이터랩 설정 가능
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# 선택: 영상 프레임 추출 기능이 쓰는 FFmpeg/FFprobe 실행 경로 (PATH에 있으면 안 넣어도 됨)
FFMPEG_PATH=
FFPROBE_PATH=

# 선택: 스레드 주제 태그(topic_tag) 자동 부착 — 기본 on. 끄려면 off
THREADS_TOPIC_TAGS=on
# 선택: 자동발행 시간대(KST). 기본 07시~24시 사이에만 슬롯을 배치 (새벽 발행 = 초반 반응 0 = 도달 손실)
AUTOPILOT_ACTIVE_START_HOUR=7
AUTOPILOT_ACTIVE_END_HOUR=24
# 선택: 예정 시각보다 이 분(分) 이상 밀린 미발행 글은 폐기 (기본 15)
STALE_PENDING_MINUTES=15

# 권장: 저장된 API 키·토큰 암호화 키 (아무 긴 무작위 문자열). 비워두면 db/secret.key 를 자동 생성해 사용
# 한 번 설정하면 바꾸지 마세요 (바꾸면 이전 키로 저장된 값은 부팅 시 새 키로 자동 재암호화됩니다 — 단 이전 키 파일이 남아 있을 때만)
ME2_SECRET_KEY=
